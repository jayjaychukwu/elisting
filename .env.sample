SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Django settings module used by local `uv run` commands and the web container.
DJANGO_SETTINGS_MODULE=config.settings.dev

# PostgreSQL + PostGIS.
# Use POSTGRES_HOST=localhost when running commands directly on the host.
# Docker Compose overrides this to `db` inside the web container.
POSTGRES_DB=elisting
POSTGRES_USER=elisting
POSTGRES_PASSWORD=elisting
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Redis cache.
# Use redis://localhost:6381/0 when running commands directly on the host.
# Docker Compose overrides this to redis://redis:6379/0 inside the web container.
# Leave empty to fall back to an in-process locmem cache.
REDIS_URL=redis://localhost:6381/0
REDIS_PORT=6381

# JWT access token lifetime in minutes.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
